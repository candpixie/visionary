{
  "expo": {
    "name": "Visionary Camera",
    "slug": "visionary-camera",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1a1a1a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.visionary.camera"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a1a"
      },
      "permissions": [
        "CAMERA"
      ],
      "package": "com.visionary.camera"
    },
    "web": {
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Visionary to access your camera to stream video to your laptop."
        }
      ]
    ]
  }
}

